<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permits cleartext HTTP communication with user-configured local ESP32 IP addresses -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
